import java.util.Scanner;

public class ReverseNumber {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        
        
        int N = sc.nextInt();
        
        int reversed = 0;
        int num = N;
        
        
        while (num > 0) {
            int digit = num % 10;       
            reversed = reversed * 10 + digit; 
            num = num / 10;             
        }
        
    
        System.out.println(reversed);
        
        sc.close();
    }
}
